{
	"$id": "https://schemas.lbrunner.net/typst/typst.schema.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"description": "Typst package manifest (typst.toml) with the tytanic test-runner settings. Best-effort schema: [package] is only partially described (Typst publishes no formal schema); [tool.tytanic] is derived from tytanic-core/src/config.rs in https://github.com/typst-community/tytanic.",
	"properties": {
		"package": {
			"properties": {
				"entrypoint": { "type": "string" },
				"name": { "type": "string" },
				"version": { "type": "string" }
			},
			"required": ["name", "version", "entrypoint"],
			"type": "object"
		},
		"tool": {
			"properties": {
				"tytanic": {
					"additionalProperties": false,
					"properties": {
						"default": {
							"additionalProperties": false,
							"properties": {
								"dir": { "default": "ltr", "enum": ["ltr", "rtl"] },
								"max-delta": { "default": 1, "maximum": 255, "minimum": 0, "type": "integer" },
								"max-deviations": { "default": 0, "minimum": 0, "type": "integer" },
								"ppi": { "default": 144.0, "type": "number" }
							},
							"type": "object"
						},
						"tests": { "default": "tests", "description": "Test directory, relative to this file", "type": "string" }
					},
					"type": "object"
				}
			},
			"type": "object"
		}
	},
	"required": ["package"],
	"title": "Typst manifest",
	"type": "object"
}
