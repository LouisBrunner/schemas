{
	"$defs": {
		"baptism": {
			"allOf": [
				{ "$ref": "#/$defs/commentableSource" },
				{
					"properties": {
						"date": { "$ref": "#/$defs/dateValue" },
						"godparents": {
							"items": { "$ref": "#/$defs/godparent" },
							"type": "array"
						},
						"location": { "$ref": "#/$defs/locationId" },
						"officiant": { "$ref": "#/$defs/personId" },
						"with": {
							"description": "Person IDs co-baptized in the same ceremony.",
							"items": { "$ref": "#/$defs/personId" },
							"type": "array"
						}
					},
					"type": "object"
				}
			],
			"unevaluatedProperties": false
		},

		"commentableSource": {
			"description": "Properties every object in this schema may carry, regardless of type: freeform comments and a reference to a supporting source.",
			"properties": {
				"comments": { "type": "string" },
				"source": { "$ref": "#/$defs/sourceId" }
			},
			"type": "object"
		},

		"dateContainer": {
			"allOf": [
				{ "$ref": "#/$defs/commentableSource" },
				{
					"properties": {
						"date": { "$ref": "#/$defs/dateValue" },
						"day": { "$ref": "#/$defs/day" },
						"location": { "$ref": "#/$defs/locationId" },
						"month": { "$ref": "#/$defs/month" },
						"precision": {
							"enum": ["approximate", "estimated"],
							"type": "string"
						},
						"year": { "$ref": "#/$defs/year" }
					},
					"type": "object"
				}
			],
			"description": "Shape shared by birth/death/baptism/begin/end-event date info: either `date`, or bare year/month/day for a partial date."
		},

		"dateValue": {
			"description": "Either a plain ISO-ish date string (\"YYYY-MM-DD\", \"YYYY-MM\", \"--MM-DD\", or \"YYYY\"), or an alternative-calendar object giving at least one non-Gregorian representation, optionally alongside its Gregorian equivalent.",
			"oneOf": [
				{
					"pattern": "^(\\d{4}(-\\d{2}(-\\d{2})?)?|--\\d{2}-\\d{2})$",
					"type": "string"
				},
				{
					"additionalProperties": false,
					"anyOf": [
						{ "required": ["republican"] },
						{ "required": ["gregorian"] }
					],
					"properties": {
						"gregorian": {
							"description": "Gregorian equivalent of the `republican` date, same shape as the plain date string form.",
							"pattern": "^(\\d{4}(-\\d{2}(-\\d{2})?)?|--\\d{2}-\\d{2})$",
							"type": "string"
						},
						"republican": {
							"description": "Natural form, e.g. \"1 Vendémiaire I\".",
							"type": "string"
						}
					},
					"type": "object"
				}
			]
		},

		"day": {
			"description": "Zero-padded day of month, \"01\"-\"31\".",
			"pattern": "^(0[1-9]|[12][0-9]|3[01])$",
			"type": "string"
		},

		"education": {
			"allOf": [
				{ "$ref": "#/$defs/dateContainer" },
				{
					"properties": {
						"title": {
							"description": "Name of the diploma, degree, or qualification obtained.",
							"type": "string"
						}
					},
					"required": ["title"],
					"type": "object"
				}
			],
			"unevaluatedProperties": false
		},

		"godparent": {
			"allOf": [
				{ "$ref": "#/$defs/commentableSource" },
				{
					"properties": {
						"id": { "$ref": "#/$defs/personId" },
						"role": {
							"description": "The godparent's role or relationship at the baptism, e.g. \"godmother\".",
							"type": "string"
						}
					},
					"required": ["id", "role"],
					"type": "object"
				}
			],
			"unevaluatedProperties": false
		},

		"location": {
			"additionalProperties": false,
			"properties": {
				"comments": { "type": "string" },
				"full": {
					"description": "Fully qualified name (down to country, for real-world places).",
					"type": "string"
				},
				"name": { "description": "Short display name.", "type": "string" }
			},
			"required": ["name", "full"],
			"type": "object"
		},
		"locationId": {
			"description": "Arbitrary unique ID referencing an entry in the top-level `locations` lookup table.",
			"type": "string"
		},

		"media": {
			"additionalProperties": false,
			"properties": {
				"comments": { "type": "string" },
				"file": {
					"description": "Path or filename of the media file, relative to wherever media assets are stored.",
					"type": "string"
				},
				"id": {
					"description": "Arbitrary unique ID referencing this entry from elsewhere in the file.",
					"type": "string"
				},
				"linked_people": {
					"description": "Person IDs this file documents or depicts. Omit for files not tied to specific people (e.g. a whole-tree diagram).",
					"items": { "$ref": "#/$defs/personId" },
					"type": "array"
				},
				"title": {
					"description": "Display title of the media item.",
					"type": "string"
				},
				"type": {
					"description": "Category of media file.",
					"enum": [
						"audio",
						"book",
						"card",
						"electronic",
						"fiche",
						"film",
						"magazine",
						"manuscript",
						"map",
						"newspaper",
						"photo",
						"tombstone",
						"video",
						"other"
					],
					"type": "string"
				}
			},
			"required": ["id", "file", "title"],
			"type": "object"
		},

		"military": {
			"allOf": [
				{ "$ref": "#/$defs/commentableSource" },
				{
					"properties": {
						"conflict": {
							"description": "Name of the war or conflict this military record relates to.",
							"type": "string"
						},
						"corps": {
							"description": "Military unit, regiment, or branch of service.",
							"type": "string"
						},
						"exempted": { "type": "boolean" },
						"location": { "$ref": "#/$defs/locationId" },
						"service": {
							"description": "Whether the person actually served, as distinct from being exempted.",
							"type": "boolean"
						}
					},
					"type": "object"
				}
			],
			"unevaluatedProperties": false
		},

		"month": {
			"description": "Zero-padded month, \"01\"-\"12\".",
			"pattern": "^(0[1-9]|1[0-2])$",
			"type": "string"
		},

		"nameVariant": {
			"allOf": [
				{ "$ref": "#/$defs/commentableSource" },
				{
					"properties": {
						"first": {
							"description": "First/given name in this alternate form.",
							"type": "string"
						},
						"last": {
							"description": "Last/family name in this alternate form.",
							"type": "string"
						},
						"type": {
							"description": "Category of this alternate name, e.g. the name given at birth, a commonly-used name, a maiden name, or a married name.",
							"enum": ["birth", "maiden", "married", "usage"],
							"type": "string"
						}
					},
					"required": ["first", "last"],
					"type": "object"
				}
			],
			"unevaluatedProperties": false
		},

		"occupation": {
			"allOf": [
				{ "$ref": "#/$defs/dateContainer" },
				{
					"properties": {
						"current": {
							"description": "Whether this is the person's current occupation.",
							"type": "boolean"
						},
						"title": {
							"description": "Job title or occupation name.",
							"type": "string"
						}
					},
					"required": ["title"],
					"type": "object"
				}
			],
			"unevaluatedProperties": false
		},

		"partialDate": {
			"additionalProperties": false,
			"properties": {
				"day": { "$ref": "#/$defs/day" },
				"month": { "$ref": "#/$defs/month" },
				"precision": {
					"enum": ["approximate", "estimated"],
					"type": "string"
				},
				"year": { "$ref": "#/$defs/year" }
			},
			"type": "object"
		},

		"person": {
			"allOf": [
				{ "$ref": "#/$defs/commentableSource" },
				{
					"properties": {
						"baptism": { "$ref": "#/$defs/baptism" },
						"birth": {
							"allOf": [{ "$ref": "#/$defs/dateContainer" }],
							"unevaluatedProperties": false
						},
						"contact_url": {
							"description": "URL for contacting this person.",
							"format": "uri",
							"type": "string"
						},
						"death": {
							"allOf": [
								{ "$ref": "#/$defs/dateContainer" },
								{
									"properties": {
										"cause": { "type": "string" }
									},
									"type": "object"
								}
							],
							"description": "Absent entirely = living/unknown. `{}` (present, empty) = known deceased with no further details -- this is the canonical signal, do not pair it with a separate `alive` flag.",
							"unevaluatedProperties": false
						},
						"education": {
							"items": { "$ref": "#/$defs/education" },
							"type": "array"
						},
						"id": { "$ref": "#/$defs/personId" },
						"military": {
							"items": { "$ref": "#/$defs/military" },
							"type": "array"
						},
						"names": {
							"allOf": [
								{ "$ref": "#/$defs/commentableSource" },
								{
									"properties": {
										"first": {
											"description": "First/given name.",
											"type": "string"
										},
										"last": {
											"description": "Last/family name.",
											"type": "string"
										},
										"middle": {
											"description": "Middle name(s).",
											"type": "string"
										},
										"others": {
											"items": { "$ref": "#/$defs/nameVariant" },
											"type": "array"
										}
									},
									"required": ["first", "last"],
									"type": "object"
								}
							],
							"unevaluatedProperties": false
						},
						"occupations": {
							"items": { "$ref": "#/$defs/occupation" },
							"type": "array"
						},
						"parents": {
							"additionalProperties": false,
							"properties": {
								"father": { "$ref": "#/$defs/personId" },
								"mother": { "$ref": "#/$defs/personId" }
							},
							"type": "object"
						},
						"photos": {
							"description": "Ordered list of photo URIs; the first is treated as the primary/profile photo.",
							"items": { "format": "uri", "type": "string" },
							"type": "array"
						},
						"residences": {
							"items": { "$ref": "#/$defs/residence" },
							"type": "array"
						},
						"sex": { "enum": ["M", "F", "U"], "type": "string" }
					},
					"required": ["id", "sex", "names"],
					"type": "object"
				}
			],
			"unevaluatedProperties": false
		},
		"personId": {
			"description": "Arbitrary unique ID referencing an entry in the top-level `people` array.",
			"type": "string"
		},

		"relation": {
			"allOf": [
				{ "$ref": "#/$defs/commentableSource" },
				{
					"properties": {
						"begin": {
							"allOf": [
								{ "$ref": "#/$defs/dateContainer" },
								{
									"properties": {
										"time": {
											"description": "Time of day, \"HH:MM\".",
											"pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
											"type": "string"
										},
										"witnesses": {
											"items": { "$ref": "#/$defs/personId" },
											"type": "array"
										}
									},
									"type": "object"
								}
							],
							"unevaluatedProperties": false
						},
						"end": {
							"description": "History of status changes, in case a couple separates before divorcing, etc.",
							"items": { "$ref": "#/$defs/relationEnd" },
							"type": "array"
						},
						"location": {
							"$ref": "#/$defs/locationId",
							"description": "Fallback location used only if `begin.location` is absent."
						},
						"person1": { "$ref": "#/$defs/personId" },
						"person2": { "$ref": "#/$defs/personId" },
						"residences": {
							"items": { "$ref": "#/$defs/residence" },
							"type": "array"
						},
						"status": {
							"description": "Legacy shorthand for a single-event `end` -- prefer `end` for new data.",
							"enum": ["divorced", "separated"],
							"type": "string"
						},
						"type": {
							"enum": ["wedding", "pacs", "relationship"],
							"type": "string"
						}
					},
					"required": ["type"],
					"type": "object"
				}
			],
			"unevaluatedProperties": false
		},

		"relationEnd": {
			"allOf": [
				{ "$ref": "#/$defs/commentableSource" },
				{
					"properties": {
						"date": {
							"oneOf": [
								{ "$ref": "#/$defs/dateValue" },
								{ "$ref": "#/$defs/partialDate" }
							]
						},
						"status": { "enum": ["divorced", "separated"], "type": "string" }
					},
					"required": ["status"],
					"type": "object"
				}
			],
			"unevaluatedProperties": false
		},

		"residence": {
			"allOf": [
				{ "$ref": "#/$defs/dateContainer" },
				{
					"properties": {
						"current": { "type": "boolean" }
					},
					"type": "object"
				}
			],
			"unevaluatedProperties": false
		},

		"source": {
			"additionalProperties": false,
			"properties": {
				"comments": { "type": "string" },
				"id": {
					"description": "Arbitrary unique ID referencing this entry from elsewhere in the file.",
					"type": "string"
				},
				"title": {
					"description": "Display title of the source.",
					"type": "string"
				}
			},
			"required": ["id", "title"],
			"type": "object"
		},
		"sourceId": {
			"description": "Arbitrary unique ID referencing an entry in the top-level `sources` array.",
			"type": "string"
		},

		"submitter": {
			"allOf": [
				{ "$ref": "#/$defs/commentableSource" },
				{
					"properties": {
						"id": {
							"description": "Arbitrary unique ID referencing this entry from elsewhere in the file.",
							"type": "string"
						},
						"link_person": {
							"$ref": "#/$defs/personId",
							"description": "Person ID this submitter is the same real individual as, if any."
						},
						"name": {
							"description": "Name of the person or organization who submitted/compiled this data.",
							"type": "string"
						},
						"primary": {
							"description": "Marks the primary submitter for this file. Exactly one entry should set this true.",
							"type": "boolean"
						}
					},
					"required": ["id", "name"],
					"type": "object"
				}
			],
			"unevaluatedProperties": false
		},

		"year": {
			"description": "Year, 1-4 digits, no zero-padding.",
			"pattern": "^[0-9]{1,4}$",
			"type": "string"
		}
	},
	"$id": "https://schemas.lbrunner.net/genea/v3.schema.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"additionalProperties": false,
	"description": "genea: a standalone format for recording individuals, relationships, and supporting facts across a family tree.",
	"properties": {
		"$schema": { "type": "string" },
		"comments": {
			"description": "Free-text notes about the file or tree as a whole.",
			"items": { "type": "string" },
			"type": "array"
		},
		"locations": {
			"additionalProperties": { "$ref": "#/$defs/location" },
			"description": "ID-keyed lookup table. All `location` fields elsewhere reference a key here -- no inline place text anywhere else in the schema.",
			"type": "object"
		},
		"media": {
			"items": { "$ref": "#/$defs/media" },
			"type": "array"
		},
		"people": {
			"items": { "$ref": "#/$defs/person" },
			"type": "array"
		},
		"relations": {
			"items": { "$ref": "#/$defs/relation" },
			"type": "array"
		},
		"sources": {
			"items": { "$ref": "#/$defs/source" },
			"type": "array"
		},
		"submitters": {
			"items": { "$ref": "#/$defs/submitter" },
			"type": "array"
		},
		"version": { "const": 3 }
	},
	"required": [
		"version",
		"people",
		"relations",
		"locations",
		"sources",
		"media",
		"submitters"
	],
	"title": "genea v3",
	"type": "object"
}
